{
  "name": "@crafter/spaceship-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for the Spaceship domain registrar API",
  "type": "module",
  "license": "MIT",
  "bin": {
    "spaceship": "./bin/spaceship.js"
  },
  "files": [
    "dist",
    "bin",
    "spec"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outdir dist --format esm",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "registries": {
    "@cligentic": "https://cligentic.railly.dev/r/{name}.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
