{
  "name": "@crafter/spaceship-cli",
  "version": "0.2.1",
  "description": "Agent-first CLI for the Spaceship registrar API: all 50 operations, a trust ladder for writes, portfolio linting, and a drift linter",
  "type": "module",
  "license": "MIT",
  "bin": {
    "spaceship": "./bin/spaceship.js"
  },
  "files": [
    "dist",
    "bin",
    "spec",
    "skills",
    "README.md",
    "stub"
  ],
  "scripts": {
    "build": "bun scripts/embed-skills.ts && bun build src/cli.ts --target=node --outdir dist --format esm",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "bun run build && bun test",
    "embed": "bun scripts/embed-skills.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "registries": {
    "@cligentic": "https://cligentic.railly.dev/r/{name}.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "spaceship",
    "domains",
    "dns",
    "registrar",
    "cli",
    "agent",
    "sellerhub",
    "hyperlift",
    "whois",
    "domain-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/spaceship-cli.git"
  },
  "homepage": "https://github.com/crafter-station/spaceship-cli#readme",
  "bugs": {
    "url": "https://github.com/crafter-station/spaceship-cli/issues"
  },
  "author": "Railly Hugo",
  "publishConfig": {
    "access": "public"
  }
}